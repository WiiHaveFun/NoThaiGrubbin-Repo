% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (human);
\chainin (W) [join=by ProcessHVA];
\chainin (SP) [join=by ProcessHVA];
\chainin (human) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (W);
\chainin (wing) [join=by ProcessHVA];
\chainin (AVL) [join=by ProcessHVA];
\chainin (wing) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (wing);
\chainin (tail) [join=by ProcessHVA];
\chainin (AVL) [join=by ProcessHVA];
\chainin (tail) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (wing);
\chainin (AF) [join=by ProcessHVA];
\chainin (wing) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (wing);
\chainin (RFP) [join=by ProcessHVA];
\chainin (human) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (tail);
\chainin (RFP) [join=by ProcessHVA];
\chainin (human) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (W);
\chainin (CG) [join=by ProcessHVA];
\chainin (gear) [join=by ProcessHVA];
\chainin (W) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
