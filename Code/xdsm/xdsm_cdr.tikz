(wing) edge [DataLine] (left_output_wing)
(tail) edge [DataLine] (left_output_tail)
(AF) edge [DataLine] (left_output_AF)
(CG) edge [DataLine] (left_output_CG)
(gear) edge [DataLine] (left_output_gear)
% Vertical edges
(human-W) edge [DataLine] (W)
(human-SP) edge [DataLine] (SP)
